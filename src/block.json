{
  "apiVersion": 2,
  "version": "2.4.0",
  "name": "bigb/image-gallery",
  "title": "Image Gallery",
  "description": "Create responsive image galleries, masonry layouts, lightboxes, and 3D image sliders.",
  "category": "widgets",
  "keywords": [
    "gallery",
    "image gallery",
    "photo gallery",
    "masonry",
    "lightbox",
    "grid",
    "portfolio",
    "album",
    "slider",
    "3d gallery",
    "responsive gallery"
  ],
  "textdomain": "image-gallery",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "cId": {
      "type": "string",
      "default": ""
    },
    "gallery": {
      "type": "array",
      "default": [
        {
          "id": 1,
          "title": "Title 1",
          "subtitle": "Subtitle 1",
          "images": [],
          "colors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#505a64d9"
          },
          "btnColors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#000a1480"
          }
        },
        {
          "id": 2,
          "title": "Title 2",
          "subtitle": "Subtitle 2",
          "images": [],
          "colors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#505a64d9"
          },
          "btnColors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#000a1480"
          }
        },
        {
          "id": 3,
          "title": "Title 3",
          "subtitle": "Subtitle 3",
          "images": [],
          "colors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#505a64d9"
          },
          "btnColors": {
            "color": "#fff",
            "bgType": "solid",
            "bg": "#000a1480"
          }
        }
      ]
    },
    "imagesData": {
      "type": "object",
      "default": {
        "images": []
      }
    },
    "styles": {
      "type": "object",
      "default": {}
    },
    "slideSpeed": {
      "type": "number",
      "default": 3
    },
    "itemHeight": {
      "type": "string",
      "default": "550px"
    },
    "columns": {
      "type": "object",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      }
    },
    "columnGap": {
      "type": "string",
      "default": "30px"
    },
    "rowGap": {
      "type": "string",
      "default": "40px"
    },
    "background": {
      "type": "object",
      "default": {
        "type": "gradient",
        "gradient": "linear-gradient(#ff5f6d, #ffc371)"
      }
    },
    "shadow": {
      "type": "object",
      "default": {
        "vOffset": "4px",
        "blur": "4px",
        "spreed": "0px",
        "color": "#000a1459"
      }
    },
    "hoverShadow": {
      "type": "object",
      "default": {
        "vOffset": "12px",
        "blur": "20px",
        "spreed": "-12px",
        "color": "#000a14cc"
      }
    },
    "titleTypo": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 48,
          "tablet": 40,
          "mobile": 32
        }
      }
    },
    "subtitleTypo": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 20,
          "tablet": 18,
          "mobile": 16
        }
      }
    },
    "styleSl": {
      "type": "string",
      "default": "styleDefault"
    },
    "albums": {
      "type": "array",
      "default": []
    },
    "filter": {
      "type": "object",
      "default": {
        "display": false,
        "allText": "All",
        "align": "center",
        "margin": {
          "bottom": "25px"
        }
      }
    },
    "filterBtnColors": {
      "type": "object",
      "default": {
        "color": "#444444",
        "bg": "#f0f2f5"
      }
    },
    "filterBtnActiveColors": {
      "type": "object",
      "default": {
        "color": "#ffffff",
        "bg": "#146ef5"
      }
    },
    "filterBtnTypo": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 14,
          "tablet": 14,
          "mobile": 14
        }
      }
    },
    "watermark": {
      "type": "object",
      "default": {
        "enable": false,
        "type": "text",
        "text": "",
        "image": "",
        "position": "bottom-right",
        "opacity": 0.7,
        "fontSize": 14,
        "color": "#ffffff",
        "applyOn": "both"
      }
    },
    "disableRightClick": {
      "type": "boolean",
      "default": false
    },
    "enableLightbox": {
      "type": "boolean",
      "default": true
    },
    "enableLoadMore": {
      "type": "boolean",
      "default": false
    },
    "imagesPerLoad": {
      "type": "number",
      "default": 10
    },
    "loadMoreBtnText": {
      "type": "string",
      "default": "Load More"
    },
    "loadMoreBtnColors": {
      "type": "object",
      "default": {
        "color": "#ffffff",
        "bgType": "solid",
        "bg": "#146ef5"
      }
    },
    "loadMoreBtnTypo": {
      "type": "object",
      "default": {
        "fontSize": 16,
        "borderRadius": 4
      }
    },
    "aspectRatio": {
      "type": "string",
      "default": "original"
    },
    "objectFit": {
      "type": "string",
      "default": "cover"
    },
    "showLightboxCounter": {
      "type": "boolean",
      "default": true
    },
    "showLightboxFullscreen": {
      "type": "boolean",
      "default": true
    },
    "showLightboxDownload": {
      "type": "boolean",
      "default": true
    },
    "showLightboxShare": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "example": {
