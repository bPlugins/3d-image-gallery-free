{
  "apiVersion": 2,
  "version": "2.3.2",
  "name": "bigb/image-gallery",
  "title": "Image Gallery",
  "description": "Create responsive image galleries, masonry layouts, lightboxes, and 3D image sliders.",
  "category": "widgets",
  "keywords": ["gallery", "image gallery", "photo gallery", "masonry", "lightbox", "grid", "portfolio", "album", "slider", "3d gallery", "responsive gallery"],
  "textdomain": "image-gallery",
